# InvoiceEase 后端配置模板
# 用法：复制为 backend/.env 并按需修改（.env 已被 .gitignore 忽略，勿提交真实密钥）
# 所有配置均在进程启动时加载一次，修改后需重启 uvicorn / arq worker
# 完整定义见 src/invoicing/config.py（环境变量前缀 INVOICING_）

# ---- 运行形态 ----
# dev（本机开发，自检宽松）| production（对外服务：弱密钥 / 未配置 inbox_dir / 离线模式 + 云端 LLM 一律拒绝启动）
INVOICING_ENV=dev

# ---- 数据库与队列 ----
# 开发默认：SQLite + 进程内队列（无需外部服务）
INVOICING_DATABASE_URL=sqlite:///./invoicing.db
INVOICING_QUEUE_BACKEND=local
# 生产对齐：PostgreSQL + Redis（arq worker）
# INVOICING_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/invoiceease
# INVOICING_QUEUE_BACKEND=redis
# INVOICING_REDIS_URL=redis://localhost:6379/0

# ---- 原件存储 ----
INVOICING_STORAGE_BACKEND=local
INVOICING_STORAGE_ROOT=./data/originals
# 生产对齐：S3 兼容对象存储（MinIO / 阿里云 OSS）
# INVOICING_STORAGE_BACKEND=s3
# INVOICING_MINIO_ENDPOINT=localhost:9000
# INVOICING_MINIO_ACCESS_KEY=minioadmin
# INVOICING_MINIO_SECRET_KEY=minioadmin
# INVOICING_MINIO_BUCKET=invoice-originals
# INVOICING_MINIO_SECURE=false

# ---- 安全（生产必须覆盖） ----
INVOICING_JWT_SECRET=change-me
# INVOICING_JWT_ALGORITHM=HS256
# INVOICING_JWT_EXPIRE_MINUTES=480
# MCP 接口访问令牌（legacy 内建令牌，默认关闭）：留空=关闭（推荐，改用个人令牌）
# 仅为兼容旧 WorkBuddy 全局配置时才显式设置；设置后映射为最小 id 的 admin 全权
INVOICING_MCP_TOKEN=
# 邮箱密码加密密钥（32 字节 base64；生产必须覆盖）
# 必填：44 字符 urlsafe base64（32 字节）。生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未配置时凭据加密被拒绝（邮箱功能不可用）；更换 key 需用 scripts/reencrypt_secrets.py 迁移
INVOICING_FERNET_KEY=
# 初始管理员（首次启动创建）
INVOICING_ADMIN_USERNAME=admin
INVOICING_ADMIN_PASSWORD=admin123
# 登录限流：窗口内连续失败达上限即锁定 (ip, username)（进程内实现，单进程部署有效）
# INVOICING_LOGIN_MAX_FAILURES=5
# INVOICING_LOGIN_LOCKOUT_MINUTES=15
# Web 防线（空=关闭，同源部署零行为变化；跨域/多域名部署时配置）
# INVOICING_CORS_ORIGINS=https://invoice.example.com
# INVOICING_ALLOWED_HOSTS=invoice.example.com

# ---- 业务 ----
# WorkBuddy 附件目录信任边界（extract 工具只读该目录内文件；空=不限制，production 形态下为空将拒绝启动）
INVOICING_WORKBUDDY_INBOX_DIR=
# 验真 mock 规则（真实国税 API 未接入前使用）
# INVOICING_MOCK_VERIFY_RULES={"fail_prefixes": ["0000"], "error_prefixes": ["0001"]}
INVOICING_SCHEDULER_ENABLED=true
# INVOICING_LOG_LEVEL=INFO

# ---- LLM 引擎（OCR + 大模型，Phase 2；默认关闭=与 MVP 行为一致） ----
# 开关：true 启用 LLM 兜底（纯版式 PDF/模糊件/OCR 低置信度时触发）
INVOICING_LLM_ENABLED=false
# OpenAI 兼容端点 URL：
#   云端（DashScope 百炼兼容模式，默认）：https://dashscope.aliyuncs.com/compatible-mode/v1
#   生产离线（数据不出内网）：改内网 vLLM/Ollama，如 http://192.168.1.10:8000/v1
INVOICING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API Key（DashScope 百炼控制台创建；本地 Ollama 可留空）
INVOICING_LLM_API_KEY=
# 文本结构化通道模型 / 图像（VLM）通道模型
# 提示：VLM 可选——留空（INVOICING_LLM_MODEL_VLM=）即禁用图像兜底通道，
# 链末直接落待复核，不调用视觉模型（适合只开 qwen-plus 的成本控制场景）
INVOICING_LLM_MODEL_TEXT=qwen-plus
INVOICING_LLM_MODEL_VLM=qwen-vl-plus
# 单次调用超时（秒）与重试次数；超时/异常自动降级，不阻塞解析主链路
INVOICING_LLM_TIMEOUT_SECONDS=60.0
INVOICING_LLM_MAX_RETRIES=1
# 离线部署声明：true 时启用云端 LLM 端点将拒绝启动（FRD：数据不出企业内网）
# INVOICING_OFFLINE_DEPLOY=false

# 数字员工 P2：企微群机器人 webhook（留空=不启用通知）
INVOICING_NOTIFY_WEBHOOK_URL=

# 数字员工 P3：渐进自主阈值（0=观察期全人工；如 0.95 表示预判 approve 且置信度≥0.95 自动通过；拦截永不自动）
INVOICING_AUTO_REVIEW_THRESHOLD=0

# ---- 运维兜底（design/2026-09-16-运维兜底设计.md）----
# 日志落盘（INVOICING_LOG_LEVEL 由此生效；敏感键值自动打码）
# INVOICING_LOG_DIR=./logs
# INVOICING_LOG_MAX_BYTES=10485760
# INVOICING_LOG_BACKUP_COUNT=9
# 备份目录与保留份数（SQLite 快照 + 原件打包，每日 02:17）
# INVOICING_OPS_BACKUP_DIR=./data/backups
# INVOICING_OPS_BACKUP_RETENTION=7
# 启动自检（true 时密钥类 warn 项升级为阻断；INVOICING_ENV=production 等效开启；默认只告警不阻断）
# INVOICING_STARTUP_CHECKS_STRICT=false
# 告警阈值（送达走 INVOICING_NOTIFY_WEBHOOK_URL 企微机器人）
# INVOICING_ALERT_COOLDOWN_HOURS=4
# INVOICING_ALERT_DISK_MIN_PERCENT=10
# INVOICING_ALERT_REVIEW_BACKLOG=50
# INVOICING_ALERT_PARSE_ERROR_RATE=0.2
# INVOICING_ALERT_PARSE_ERROR_MIN=5
